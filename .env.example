# Required -------------------------------------------------------------------

# Base URL of your Immich server, without a trailing /api.
IMMICH_URL=http://immich-server:2283

# Account Settings -> API Keys in the Immich web UI. Create the key on the account
# that owns the videos; the graded copies are uploaded as that user.
IMMICH_API_KEY=

# Shared secret. Set the same value as the workflow webhook's "Header value".
WEBHOOK_TOKEN=


# Detection ------------------------------------------------------------------

# Comma separated. Videos from other cameras are skipped without being downloaded.
# Set to an empty value to consider every video.
CAMERA_MODELS=ZV-E1

# Matched against Sony's CaptureGammaEquation, so this covers s-log2, s-log3,
# and s-log3-cine. Widen it to also catch hlg if you want those graded too.
LOG_GAMMA_PATTERN=^s-log

# When a clip carries no gamma metadata, guess from pixel statistics instead of
# skipping. Less reliable than the metadata, so it is off by default. Turn it on
# only if you find that uploads are arriving with the Sony metadata stripped.
PIXEL_FALLBACK_ENABLED=false


# Encoding -------------------------------------------------------------------

# 18 is visually close to the source. Lower is better quality and a larger file.
ENCODE_CRF=18

# x264 preset. slow gives noticeably smaller files than medium for the same CRF.
ENCODE_PRESET=slow

# 0 keeps the source resolution. Set to 1080 or 720 to downscale while grading.
ENCODE_MAX_HEIGHT=0

AUDIO_BITRATE=192k

# Path to the .cube to apply. Mount your own into ./luts and point this at it to
# use a different look.
LUT_PATH=/app/luts/slog3-to-rec709.cube


# Library layout -------------------------------------------------------------

# Appended to the graded file's name. Also how the service recognizes its own
# output, so it must not be empty.
GRADED_SUFFIX=_rec709

# Stack the graded version over the original, with the graded one as the cover.
STACK_ASSETS=true

TAG_ASSETS=true
ORIGINAL_TAG=S-Log3
GRADED_TAG=Rec709 graded

# Also hide the original from the main timeline. Stacking already collapses it,
# so this is usually unnecessary.
ARCHIVE_ORIGINAL=false


# Operations -----------------------------------------------------------------

PORT=8710
BIND_ADDRESS=0.0.0.0
WEBHOOK_HEADER=x-grader-token
WORK_DIR=/work

# How many clips to grade at once. Raise it only if you have the CPU to spare.
CONCURRENCY=1

# Detect and log, but do not encode or upload anything. Useful for a first pass.
DRY_RUN=false

# Leave downloads and graded files in WORK_DIR for inspection.
KEEP_WORK_FILES=false

# debug, info, warn, or error.
LOG_LEVEL=info
